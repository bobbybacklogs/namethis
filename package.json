{
  "name": "@genoventures-labs/namethis",
  "version": "0.3.0",
  "description": "Lightweight, repo-aware project naming CLI powered by ModelHitch",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "namethis": "dist/cli.js"
  },
  "files": [
    "dist",
    "instructs.txt",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobbybacklogs/namethis.git"
  },
  "homepage": "https://github.com/bobbybacklogs/namethis#readme",
  "bugs": {
    "url": "https://github.com/bobbybacklogs/namethis/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "start": "node dist/cli.js",
    "dev": "tsc -w",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "naming",
    "project-names",
    "ai",
    "developer-tools",
    "modelhitch",
    "vercel-ai-gateway",
    "branding"
  ],
  "author": "genoventures-labs",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "modelhitch": "^2.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
